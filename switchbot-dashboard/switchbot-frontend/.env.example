# Backend base URL.
#
# Leave empty to call the same origin that serves the frontend (production
# behaviour: FastAPI serves the built assets and the /api routes).
#
# During `npm run dev` this value is used as the target of the Vite dev-server
# proxy for /api, so requests stay same-origin and CORS is not involved.
VITE_API_URL=https://snakeroom.fly.dev
