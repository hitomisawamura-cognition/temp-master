# Base URL of the FastAPI backend. Leave empty to use the same origin
# (FastAPI serves the built dist/ in production; Vite proxies /api in dev).
VITE_API_URL=
# Dev-server proxy target used when VITE_API_URL is empty.
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Optional JSON object merged over the default device display names.
# VITE_DISPLAY_NAMES={"Bedroom Meter":"Main Tower"}
# Optional URL of a JSON file (same shape) loaded at runtime, e.g. /display-names.json
# VITE_DISPLAY_NAMES_URL=
