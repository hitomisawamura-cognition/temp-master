# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# Token required by the administrative endpoints (GET /api/backup, POST /api/import).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When left empty those endpoints return 503 and are unusable.
ADMIN_TOKEN=

# Comma separated origins allowed for cross-origin browser requests.
# Leave empty when the frontend is served from the same origin as the backend.
ALLOWED_ORIGINS=
